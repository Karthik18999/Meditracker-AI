PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/meditracker
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173
NODE_ENV=production

# Option 1: Brevo SMTP Configuration (Recommended for live email delivery)
EMAIL_SERVICE=brevo
BREVO_USER=your_brevo_account_email@domain.com
BREVO_KEY=your_brevo_smtp_key_xkeysib-xxx

# Option 2: Custom / Standard SMTP
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_login
# EMAIL_PASS=your_smtp_password
# EMAIL_FROM=no-reply@yourdomain.com
